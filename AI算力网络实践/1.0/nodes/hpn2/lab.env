#!/usr/bin/env bash
# ============================================================================
# HPN-3 实验台 · 唯一需要手工修改的文件
# 三台机器上各放一份，只改 ROLE，其余三项三台填完全一样。
# ============================================================================

# ---- 1. 本机角色：a = 发送端(headend)，b = 接收端(tailend)，c = 中转(fabric)
ROLE="b"

# ---- 2. 物理网卡
IFACE="eth0"

# ---- 3. 三台机器的内网 IPv6 地址（必须同一 VPC、同一子网段，详见 docs/01）
NODE_A_IPV6="240b:4001:1ed:2e02:2a60:59b3:348:f9a7"
NODE_B_IPV6="240b:4001:1ed:2e02:2a60:59b3:348:f9a5"
NODE_C_IPV6="240b:4001:1ed:2e02:2a60:59b3:348:f9a6"

# ============================================================================
# 以下为实验参数，正常情况下不要改
# ============================================================================

# uSID 规划：32 bit block + 16 bit node，符合 RFC 9800 默认 lblen/nflen
USID_BLOCK="fcbb:bb00"
U_TRANSIT="2"          # node-c 上的 uN，平面 0 的中转段
U_TAIL="e000"          # node-b 上的 uDT6，交付段

# 服务地址：b 的 VRF 内 dummy 口，所有业务流的真实目的地址
SERVICE_ADDR="fd00:b0b0::1"

# 平面 0 = 绕行（a -> c -> b，带 1 个中转 uSID）
# 平面 1 = 直达（a -> b，无中转 uSID）
PLANE0_MARK="0x2"
PLANE1_MARK="0x1"
PLANE0_TABLE="100"
PLANE1_TABLE="101"

# VRF（仅 b 用）
VRF_NAME="vrf-hpn"
VRF_TABLE="1000"

# 探路用的测试地址（挂在 c 的 lo 上，验证 ULA 外层目的地址能否穿过 vSwitch）
PROBE_ADDR="fcbb:bb00:ffff::1"

# 故障注入与观测的落盘目录
LAB_DIR="/var/lib/hpnlab"
